{
  "name": "sushi-panic",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "寿司别吃撑！ — zero-runtime-dependency survival arcade",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/core.test.mjs tests/api.test.mjs",
    "db:generate": "drizzle-kit generate",
    "test:sim": "node scripts/simulate.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:sim && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2"
  },
  "engines": {
    "node": ">=24"
  }
}
